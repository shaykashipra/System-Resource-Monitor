<Window x:Class="SystemResourceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SystemResourceMonitor.Models"
        Title="System Resource Monitor" Width="1280" Height="800" MinWidth="1040" MinHeight="680"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource PrimaryText}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="MetricCardTemplate" DataType="{x:Type models:MetricCard}">
            <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{Binding AccentSurface}" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding Tag}" Foreground="{Binding Accent}" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Value}" FontSize="34" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,10" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                        <ProgressBar Value="{Binding Progress}" Foreground="{Binding Accent}" Height="7" />
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,9,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="210" /><RowDefinition Height="20" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="System Resource Monitor" FontSize="27" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{StaticResource GreenAccent}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Starting monitor..." Foreground="{StaticResource MutedText}" FontSize="13" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Style="{StaticResource DashboardButtonStyle}" Click="Refresh_Click" Margin="0,0,10,0">Refresh</Button>
                <Button Style="{StaticResource DashboardButtonStyle}" Click="ToggleMonitoring_Click"><TextBlock x:Name="PauseButtonText" Text="Pause monitoring" /></Button>
            </StackPanel>
        </Grid>
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource MetricCardTemplate}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
        <Border Grid.Row="4" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Running processes" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="ProcessCountText" Text="Loading processes..." Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding ProcessSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by process name or ID" />
                </Grid>
                <DataGrid Grid.Row="2" x:Name="ProcessGrid" ItemsSource="{Binding ProcessesView}" Style="{StaticResource ProcessGridStyle}" Sorting="ProcessGrid_Sorting" MouseDoubleClick="ProcessGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Process" Binding="{Binding Name}" SortMemberPath="Name" Width="*" />
                        <DataGridTextColumn Header="PID" Binding="{Binding Id}" SortMemberPath="Id" Width="100" />
                        <DataGridTextColumn Header="Memory" Binding="{Binding MemoryDisplay}" SortMemberPath="MemoryMegabytes" Width="150" />
                        <DataGridTextColumn Header="Threads" Binding="{Binding ThreadCount}" SortMemberPath="ThreadCount" Width="110" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="Status" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <TextBlock Grid.Row="5" Text="Tip: click a column heading to sort. Double-click a process for details." Foreground="{StaticResource MutedText}" FontSize="12" Margin="2,16,0,0" />
    </Grid>
</Window>
